{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Star",
  "type": "object",
  "required": [
    "id",
    "name",
    "rank",
    "ra",
    "dec",
    "dist",
    "otype",
    "spect",
    "cat"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "proper": {
      "type": "string"
    },
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "remarks": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "by_greek": {
      "type": "string"
    },
    "by_con": {
      "type": "string"
    },
    "by_comp": {
      "type": "string"
    },
    "v": {
      "type": "string"
    },
    "v_con": {
      "type": "string"
    },
    "v_comp": {
      "type": "string"
    },
    "fl": {
      "type": "integer"
    },
    "fl_con": {
      "type": "string"
    },
    "fl_comp": {
      "type": "string"
    },
    "ra": {
      "type": "number"
    },
    "dec": {
      "type": "number"
    },
    "dist": {
      "type": "number"
    },
    "otype": {
      "type": [
        "string",
        "null"
      ]
    },
    "spect": {
      "type": [
        "string",
        "null"
      ]
    },
    "cat": {
      "type": "integer",
      "minimum": 0
    }
  },
  "dependentRequired": {
    "by": [
      "by_greek",
      "by_con"
    ],
    "by_greek": [
      "by",
      "by_con"
    ],
    "by_con": [
      "by",
      "by_greek"
    ],
    "v": [
      "v_con"
    ],
    "v_con": [
      "v"
    ],
    "fl": [
      "fl_con"
    ],
    "fl_con": [
      "fl"
    ]
  },
  "additionalProperties": false
}
